# Runtime
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Local file-backed store (used when DATABASE_URL is empty; ideal for local dev/tests).
# Leave DATABASE_URL empty for zero-dependency local development.
DATA_FILE=./data/scopelock.json

# Database (production / staging). When set to a postgres:// URL the API uses Prisma + PostgreSQL.
DATABASE_URL=
# Optional direct (non-pooled) connection for migrations against pooled providers.
DIRECT_URL=

# Authentication
AUTH_SECRET=
AUTH_URL=http://localhost:4000
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SESSION_TTL_HOURS=168
# OAuth login (Google/GitHub, authorization code + PKCE). Leave a pair empty to
# disable that provider. Register the callback as <API_URL>/api/v1/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# WebAuthn relying party. RP_ID must be the registrable host (localhost for dev);
# the browser origin must equal WEB_URL or ceremonies fail verification.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ScopeLock

# AI — server only. AI features additionally require opt-in at organization/project level.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL (used by chat failover and decision-memory embeddings).
OPENAI_BASE_URL=
# Optional Groq-compatible base URL override (defaults to https://api.groq.com/openai/v1).
GROQ_BASE_URL=
AI_PROVIDER=groq
AI_ENABLED=true

# Object storage — only if uploads are enabled (otherwise local storage under UPLOAD_DIR is used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
UPLOAD_DIR=./data/uploads
# Malware scanner webhook (POST JSON, responds {"verdict": "CLEAN"|"INFECTED"}); empty = local heuristics only
MALWARE_SCANNER_URL=
# Retention: abandoned upload intents expire after N hours; deleted file bytes purge after N days (metadata kept)
PENDING_UPLOAD_TTL_HOURS=24
DELETED_FILE_PURGE_DAYS=30

# Realtime — only if enabled; server secret, not a browser key
ABLY_API_KEY=

# Email / observability (optional for local development)
# Empty EMAIL_API_KEY = log driver (safe default). Set all three below to send via Resend.
# EMAIL_FROM must be a verified sender, e.g. "ScopeLock <noreply@yourdomain.com>"
# (or "onboarding@resend.dev" for testing — delivers to your own address only).
EMAIL_HTTP_ENDPOINT=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=
INBOUND_EMAIL_DOMAIN=inbound.scopelock.local
INBOUND_EMAIL_WEBHOOK_SECRET=
SENTRY_DSN=

# SMS / WhatsApp (optional; empty = log driver). Generic provider HTTP API: POST {to, body} with bearer key.
SMS_API_URL=
SMS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Self-hosting (docker compose only; ignored otherwise)
# Password for the compose Postgres service. Required for `docker compose up`.
DB_PASSWORD=

# Ops / testing
RATE_LIMIT_DISABLED=
# Per-API-key request budget (requests/minute/key).
API_KEY_RATE_LIMIT_PER_MIN=300
OUTBOX_AUTODRAIN=
# Postgres URL used only by the Prisma integration tests (empty = those tests are skipped).
TEST_DATABASE_URL=true
