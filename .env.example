# Runtime
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Local file-backed store (used when DATABASE_URL is empty; ideal for local dev/tests).
# Leave DATABASE_URL empty for zero-dependency local development.
DATA_FILE=./data/scopelock.json

# Database (production / staging). When set to a postgres:// URL the API uses Prisma + PostgreSQL.
DATABASE_URL=
# Optional direct (non-pooled) connection for migrations against pooled providers.
DIRECT_URL=

# Authentication
AUTH_SECRET=
AUTH_URL=http://localhost:4000
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SESSION_TTL_HOURS=168

# AI — server only. AI features additionally require opt-in at organization/project level.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_ENABLED=true

# Object storage — only if uploads are enabled (otherwise local storage under UPLOAD_DIR is used)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
UPLOAD_DIR=./data/uploads
# Malware scanner webhook (POST JSON, responds {"verdict": "CLEAN"|"INFECTED"}); empty = local heuristics only
MALWARE_SCANNER_URL=
# Retention: abandoned upload intents expire after N hours; deleted file bytes purge after N days (metadata kept)
PENDING_UPLOAD_TTL_HOURS=24
DELETED_FILE_PURGE_DAYS=30

# Realtime — only if enabled; server secret, not a browser key
ABLY_API_KEY=

# Email / observability (optional for local development)
# EMAIL_DRIVER=log  (default) — set EMAIL_API_KEY + EMAIL_FROM to enable the HTTP driver
EMAIL_API_KEY=
EMAIL_FROM=
SENTRY_DSN=

# Ops / testing
RATE_LIMIT_DISABLED=
OUTBOX_AUTODRAIN=true
