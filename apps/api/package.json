{
  "name": "@scopelock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run tests",
    "test:contracts": "vitest run tests/contract.test.ts",
    "seed": "tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.699.0",
    "@aws-sdk/s3-request-presigner": "3.699.0",
    "@prisma/client": "5.22.0",
    "@scopelock/contracts": "0.1.0",
    "@scopelock/domain": "0.1.0",
    "ably": "2.29.0",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "vitest": "2.1.8"
  }
}
